# ============================================================
# 配置模板文件 —— 复制此文件为 .env 并填入真实值后运行程序。
# .env 已加入 .gitignore，不会提交到代码仓库，凭据安全。
# ============================================================

# 数据库配置
DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=oil

# 企业微信机器人 Webhook 完整地址（https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...）
WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 在线设备配置表链接（飞书/腾讯文档/金山文档/WPS 分享链接，留空则只使用本地文件）
CONFIG_EXCEL_URL=

# 飞书开放平台 API 凭据（仅使用飞书文档时需要填写，其他平台留空）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书告警机器人 Webhook（留空则不推送告警）
FEISHU_ALERT_WEBHOOK=

# 本地备用配置文件路径（在线表格不可用时的回退，默认 device_config.xlsx）
CONFIG_LOCAL_FILE=device_config.xlsx
